# 代理环境变量模板（复制本文件为 .env 后填写；.env 已被 .gitignore 忽略，禁止提交真实 Key）
# 代理监听端口
PORT=8787
# 真实大模型 Key（仅后端环境变量持有，前端与页面源码不接触）
LLM_API_KEY=
# 上游聊天端点（OpenAI 兼容 chat/completions）
LLM_UPSTREAM=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 上游向量端点（可选，用于 RAG 语义检索；不支持向量接口的厂商留空）
EMBED_UPSTREAM=https://open.bigmodel.cn/api/paas/v4/embeddings
# 强制覆盖模型名（留空则透传前端传来的 model）
LLM_MODEL=
